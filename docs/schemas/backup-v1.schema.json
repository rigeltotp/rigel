{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rigel:schema:backup:1",
  "title": "Rigel backup payload, schema version 1",
  "description": "Normative text: docs/specs/backup-format.md. Unknown members are allowed (B-11).",
  "type": "object",
  "required": ["format", "schema_version", "created_at", "app", "entries"],
  "properties": {
    "format": { "const": "rigel-backup" },
    "schema_version": { "const": 1 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "app": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "maxLength": 64 },
        "version": { "type": "string", "maxLength": 64 }
      }
    },
    "source_vault_id": { "$ref": "#/$defs/uuid" },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/entry" }
    },
    "settings": {
      "type": "object",
      "properties": {
        "hide_codes": { "type": "boolean" },
        "clipboard_clear_s": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "sort_mode": { "type": "string", "maxLength": 32 },
        "theme": { "type": "string", "maxLength": 32 }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "domain": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9-]{2,63}$"
    },
    "appRef": {
      "type": "object",
      "required": ["platform", "id"],
      "properties": {
        "platform": { "enum": ["android", "apple"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "cert_sha256": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$" }
        }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "type", "issuer", "account", "secret", "algorithm", "digits"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "enum": ["totp", "hotp", "steam"] },
        "issuer": { "type": "string", "maxLength": 256 },
        "account": { "type": "string", "maxLength": 256 },
        "secret": {
          "type": "string",
          "pattern": "^[A-Z2-7]{2,410}$",
          "description": "Base32, uppercase, no padding; 1 to 256 bytes decoded (limit checked again in code)."
        },
        "algorithm": { "enum": ["SHA1", "SHA256", "SHA512"] },
        "digits": { "type": "integer", "minimum": 5, "maximum": 8 },
        "period": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "counter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "time_offset_s": { "type": "integer", "minimum": -3600, "maximum": 3600 },
        "websites": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/domain" } },
        "apps": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/appRef" } },
        "tags": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "favorite": { "type": "boolean" },
        "sort_key": { "type": "string", "pattern": "^[0-9A-Za-z]{1,64}$" },
        "icon": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["source", "id"],
              "properties": {
                "source": { "enum": ["builtin", "pack"] },
                "id": { "type": "string", "maxLength": 128 },
                "pack": { "$ref": "#/$defs/uuid" }
              }
            }
          ]
        },
        "note": { "type": "string", "maxLength": 4096 },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "hotp" } } },
          "then": { "required": ["counter"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["totp", "steam"] } } },
          "then": { "required": ["period"] }
        },
        {
          "if": { "properties": { "type": { "const": "steam" } } },
          "then": {
            "properties": {
              "algorithm": { "const": "SHA1" },
              "digits": { "const": 5 },
              "period": { "const": 30 }
            }
          },
          "else": { "properties": { "digits": { "minimum": 6 } } }
        }
      ]
    }
  }
}
