{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rigel:schema:vault-record-secret:1",
  "title": "Vault entry secret record (kind 2), schema version 1",
  "description": "Plaintext of a secret record before encryption, without the trailing padding. Normative text: docs/specs/vault-format.md, section 6.3.",
  "type": "object",
  "required": ["otp", "time_offset_s"],
  "properties": {
    "otp": {
      "type": "object",
      "required": ["v", "t"],
      "properties": {
        "t": { "$ref": "#/$defs/hlc" },
        "v": {
          "type": "object",
          "required": ["type", "secret", "algorithm", "digits"],
          "properties": {
            "type": { "enum": ["totp", "hotp", "steam"] },
            "secret": { "type": "string", "pattern": "^[A-Z2-7]{2,410}$" },
            "algorithm": { "enum": ["SHA1", "SHA256", "SHA512"] },
            "digits": { "type": "integer", "minimum": 5, "maximum": 8 },
            "period": { "type": "integer", "minimum": 1, "maximum": 3600 }
          },
          "allOf": [
            { "if": { "properties": { "type": { "enum": ["totp", "steam"] } } }, "then": { "required": ["period"] } },
            { "if": { "properties": { "type": { "const": "steam" } } },
              "then": { "properties": { "algorithm": { "const": "SHA1" }, "digits": { "const": 5 }, "period": { "const": 30 } } },
              "else": { "properties": { "digits": { "minimum": 6 } } } }
          ]
        }
      }
    },
    "counter": {
      "type": "object",
      "required": ["v", "t"],
      "properties": {
        "t": { "$ref": "#/$defs/hlc" },
        "v": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "time_offset_s": {
      "type": "object",
      "required": ["v", "t"],
      "properties": {
        "t": { "$ref": "#/$defs/hlc" },
        "v": { "type": "integer", "minimum": -3600, "maximum": 3600 }
      }
    }
  },
  "$defs": {
    "hlc": { "type": "string", "pattern": "^[0-9a-f]{12}-[0-9a-f]{4}-[0-9a-f]{16}$" }
  }
}
